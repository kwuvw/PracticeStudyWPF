<Page x:Class="Shop.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Shop"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <Rectangle HorizontalAlignment="Left"
                   Height="434"
                   Fill="#D2F6E7"
                   VerticalAlignment="Center"
                   Width="400" />
        <TextBlock HorizontalAlignment="Left"
                   Margin="56,0,0,0"
                   TextWrapping="Wrap"
                   Text="Модная и качественная обувь только в нашем Online магазине"
                   VerticalAlignment="Center"
                   Height="208"
                   Width="288"
                   TextAlignment="Center"
                   Foreground="#70B2AF"
                   FontSize="30px" />

        <TextBlock HorizontalAlignment="Left"
                   Foreground="#70B2AF"
                   Margin="493,147,0,0"
                   TextWrapping="Wrap"
                   Text="Введите логин"
                   VerticalAlignment="Top"
                   Height="16"
                   Width="85" />
        <TextBox x:Name="LoginTextBox"
                 HorizontalAlignment="Left"
                 Margin="494,168,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="216"
                 Height="32" />

        <Button Content="Войти"
                Click="SignInLoginButton"
                Background="#D2F6E7"
                Foreground="#70B2AF"
                HorizontalAlignment="Left"
                Margin="532,224,0,0"
                VerticalAlignment="Top"
                Height="35"
                Width="140" />
        <Image Margin="10,20,741,381"
               Source="/Чудо Обувь.png"
               Stretch="Fill" />
        <TextBlock HorizontalAlignment="Left"
                   Foreground="#70B2AF"
                   Margin="64,37,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   RenderTransformOrigin="-0.541,0.075"><Run Language="ru-ru"
                                                             Text="ЧудоОбувь" /></TextBlock>
    </Grid>
</Page>
